  "item": [
    {
      "name": "Delete User",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/users/{{userId}}",
        "description": ""
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
              "const j=pm.response.json();",
              "pm.test(\"Delete contract is returned\", () => { pm.expect(j.isDeleted).to.eql(true); pm.expect(j.deletedOn).to.be.a(\"string\"); pm.expect(String(j.id)).to.eql(pm.collectionVariables.get(\"userId\")); });"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://dummyjson.com",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "2",
      "type": "string"
    },
    {
      "key": "searchTerm",
      "value": "John",
      "type": "string"
    },
    {
      "key": "uniqueEmail",
